# Базовый образ — минимальный, alpine для меньшего размера
FROM node:20-alpine

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем только файлы зависимостей —
# так Docker кэширует этот слой и не переустанавливает
# зависимости при каждом изменении кода
COPY package*.json ./

# Устанавливаем только production-зависимости
RUN npm ci --omit=dev

# Теперь копируем остальной код приложения
COPY . .

# Переменные окружения по умолчанию (можно переопределить при запуске)
ENV PORT=3000
ENV APP_MESSAGE="Hello from Docker!"

# Порт, который слушает приложение
EXPOSE 3000

# Запуск от непривилегированного пользователя (безопасность)
USER node

# Команда запуска
CMD ["node", "app.js"]
